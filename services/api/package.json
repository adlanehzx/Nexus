{
  "name": "@nexus/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Network boundary: REST v1, WebSocket gateway and authentication",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo",
    "e2e:confirmation": "node scripts/e2e-confirmation.mjs",
    "e2e:schedule-grant": "node scripts/e2e-schedule-grant.mjs",
    "e2e:chain": "node scripts/e2e-mission-chain.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/websocket": "11.3.0",
    "@nexus/agent-core": "workspace:*",
    "@nexus/auth": "workspace:*",
    "@nexus/browser-client": "workspace:*",
    "@nexus/config": "workspace:*",
    "@nexus/connections": "workspace:*",
    "@nexus/database": "workspace:*",
    "@nexus/devices": "workspace:*",
    "@nexus/llm": "workspace:*",
    "@nexus/mcp": "workspace:*",
    "@nexus/memory": "workspace:*",
    "@nexus/mission-control-client": "workspace:*",
    "@nexus/notifications": "workspace:*",
    "@nexus/protocol": "workspace:*",
    "@nexus/shared": "workspace:*",
    "@nexus/tools": "workspace:*",
    "@nexus/web-search": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "openapi-types": "12.1.3",
    "pino": "10.3.1",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nexus/client-core": "workspace:*",
    "@nexus/worker-core": "workspace:*",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}

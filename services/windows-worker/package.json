{
  "name": "@nexus/windows-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Windows worker with controlled local capabilities and an outbound NEXUS connection",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "pair": "node dist/pair.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@nexus/device-policy": "workspace:*",
    "@nexus/devices": "workspace:*",
    "@nexus/protocol": "workspace:*",
    "@nexus/shared": "workspace:*",
    "@nexus/tools": "workspace:*",
    "@nexus/worker-core": "workspace:*",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "8.18.2",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}

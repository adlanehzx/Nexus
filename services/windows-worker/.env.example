# ── NEXUS Windows Worker ────────────────────────────────────────────────────
# Copy to .env and configure. NO SECRETS BELONG IN THIS FILE:
# the private key is referenced by PATH, never by its value.

# NEXUS Core — BASE ADDRESS, without path: worker appends /ws/worker.
# A remote address MUST use https:// or wss://.
NEXUS_BACKEND_URL=https://nexus.example.com

# WINDOWS by default. Linux/NAS/Raspberry Pi images set LINUX during pairing.
NEXUS_WORKER_PLATFORM=WINDOWS

# Device identifier assigned by backend upon pairing.
DEVICE_ID=00000000-0000-0000-0000-000000000000

# Path to Ed25519 private key (PEM).
DEVICE_CREDENTIAL_PATH=C:\ProgramData\NEXUS\nexus-device.key

# Local policy in YAML format. Empty = ~/.nexus/device-policy.yaml
# WORKER_POLICY_FILE=

# Roots accessible for read and write. Everything else is rejected.
WORKER_ALLOWED_PATHS=C:\Users\me\Projects,C:\Users\me\Documents\NEXUS

# Exposed capabilities. Empty = all locally available.
WORKER_CAPABILITIES=terminal.execute,filesystem.read,filesystem.write,process.list,git.status,git.diff,git.branch,browser.open

# Allowed programs for terminal.execute and process.start.
WORKER_ALLOWED_EXECUTABLES=git,node,pnpm,python

# Environment variables forwarded to launched processes.
WORKER_ALLOWED_ENV=PATH,SYSTEMROOT,TEMP,TMP

# Applications openable by app.open, formatted as name=path.
WORKER_APPS=chrome=C:\Program Files\Google\Chrome\Application\chrome.exe,notepad=C:\Windows\notepad.exe

# SHA-256 fingerprint (base64) of the core certificate public key.
NEXUS_CORE_FINGERPRINT=

WORKER_HEARTBEAT_INTERVAL_MS=20000
WORKER_TASK_TIMEOUT_MS=300000
WORKER_MAX_CONCURRENT_TASKS=2

WORKER_RECONNECT_MIN_MS=1000
WORKER_RECONNECT_MAX_MS=60000

# Allowed Docker subcommands. Default: inspection only.
WORKER_DOCKER_ALLOWED=ps,images,logs,inspect

# Allow git pull / checkout / commit / clone. False by default.
WORKER_GIT_ALLOW_WRITE=false

# Where to publish PUBLIC daemon state. Empty = %ProgramData%\NEXUS\worker\device.json
WORKER_STATE_PATH=

LOG_LEVEL=info

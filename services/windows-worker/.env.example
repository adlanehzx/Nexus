# ── Worker Windows NEXUS ────────────────────────────────────────────────────
# Copier en .env et renseigner. AUCUN SECRET NE FIGURE DANS CE FICHIER :
# la cle privee est designee par un CHEMIN, jamais par sa valeur.

# Coeur NEXUS — ADRESSE DE BASE, sans chemin : le worker ajoute /ws/worker.
# Une adresse distante DOIT etre en https:// ou wss:// — le worker refuse de
# demarrer sur du clair non local, car les consignes d'execution qui descendent
# par ce canal seraient lisibles et modifiables par qui se trouve sur le chemin.
NEXUS_BACKEND_URL=https://nexus.exemple.fr

# Identifiant remis par le backend a l'appairage. Public : il n'authentifie rien.
DEVICE_ID=00000000-0000-0000-0000-000000000000

# Chemin vers la cle privee Ed25519 (PEM). Elle ne quitte jamais la machine.
# Generer avec :
#   openssl genpkey -algorithm ed25519 -out nexus-device.key
#   openssl pkey -in nexus-device.key -pubout -out nexus-device.pub
DEVICE_CREDENTIAL_PATH=C:\ProgramData\NEXUS\nexus-device.key

# Racines accessibles en lecture et en ecriture. Tout le reste est refuse.
WORKER_ALLOWED_PATHS=C:\Users\moi\Projets,C:\Users\moi\Documents\NEXUS

# Capacites exposees. Vide = toutes celles reellement disponibles localement.
WORKER_CAPABILITIES=terminal.execute,filesystem.read,filesystem.write,process.list,git.status,git.diff,git.branch,browser.open

# Programmes autorises pour terminal.execute et process.start.
# Vide = liste par defaut (git, node, npm, pnpm, python, docker, tasklist, where).
WORKER_ALLOWED_EXECUTABLES=git,node,pnpm,python

# Variables d'environnement transmises aux processus lances.
# L'environnement du worker n'est JAMAIS transmis en bloc.
WORKER_ALLOWED_ENV=PATH,SYSTEMROOT,TEMP,TMP

# Applications ouvrables par app.open, sous la forme nom=chemin.
# C'est la FRONTIERE de cette capacite : elle n'accepte jamais un chemin, mais
# seulement un nom present dans cette table. Vide = app.open ne peut rien ouvrir.
WORKER_APPS=chrome=C:\Program Files\Google\Chrome\Application\chrome.exe,bloc-notes=C:\Windows
otepad.exe

# Empreinte SHA-256 (base64) de la cle publique du certificat du coeur.
# Vide = validation par les autorites du systeme seulement. La renseigner ferme
# l'usurpation par une autorite illegitime : proxy d'entreprise, logiciel de
# securite, autorite compromise. L'obtenir :
#   openssl s_client -connect nexus.exemple.fr:443 </dev/null 2>/dev/null #     | openssl x509 -pubkey -noout #     | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | base64
NEXUS_CORE_FINGERPRINT=

WORKER_HEARTBEAT_INTERVAL_MS=20000
WORKER_TASK_TIMEOUT_MS=300000
WORKER_MAX_CONCURRENT_TASKS=2

WORKER_RECONNECT_MIN_MS=1000
WORKER_RECONNECT_MAX_MS=60000

# Sous-commandes Docker autorisees. Par defaut : consultation seule.
# Elargir est une decision : l'acces au demon Docker equivaut a un acces admin.
WORKER_DOCKER_ALLOWED=ps,images,logs,inspect

# Autorise git pull / checkout / commit / clone. Faux par defaut.
WORKER_GIT_ALLOW_WRITE=false

# Ou deposer l'etat PUBLIC du demon. Vide = %ProgramData%\NEXUS\worker\device.json
# Ce fichier ne contient qu'un identifiant d'appareil : il permet a l'interface
# installee sur la meme machine de se reconnaitre, et n'ouvre aucun droit.
WORKER_STATE_PATH=

LOG_LEVEL=info

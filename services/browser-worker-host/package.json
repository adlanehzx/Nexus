{
  "name": "@nexus/browser-worker-host",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WorkerRuntime host that connects Browser Use to the NEXUS WorkerGateway",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@nexus/browser-client": "workspace:*",
    "@nexus/protocol": "workspace:*",
    "@nexus/shared": "workspace:*",
    "@nexus/tools": "workspace:*",
    "@nexus/worker-core": "workspace:*",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nexus/devices": "workspace:*",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.1",
    "vitest": "4.1.11"
  }
}

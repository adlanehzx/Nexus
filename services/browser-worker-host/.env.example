# ── Hote du worker navigateur NEXUS ─────────────────────────────────────────
# Copier en .env et renseigner. Ce fichier liste les CLES, jamais les VALEURS.
#
# Ce processus raccorde Browser Use au WorkerGateway de NEXUS. Il ne pilote
# aucun navigateur lui-meme : il appelle le worker Python, qui detient
# browser-use et Chromium (ADR-006).

# ── Vers le coeur ───────────────────────────────────────────────────────────
# Une adresse distante DOIT etre en wss://.
NEXUS_BACKEND_URL=wss://nexus.exemple.fr

# Identifiant remis par le coeur a l'appairage. Public : il n'authentifie rien.
DEVICE_ID=00000000-0000-0000-0000-000000000000

# Cle privee Ed25519 de l'appareil, au format PEM. C'est un CHEMIN : la cle ne
# figure jamais dans une variable d'environnement, ou elle apparaitrait dans
# `ps`, dans les journaux du superviseur et dans l'inspection du conteneur.
DEVICE_KEY_PATH=/run/secrets/nexus-browser-device.pem

# ── Vers le worker Python ───────────────────────────────────────────────────
# Reseau interne uniquement. NE JAMAIS exposer ce worker a Internet.
BROWSER_WORKER_URL=http://browser-worker:8100

# Jeton de service du worker Python. Ce n'est PAS l'authentification NEXUS :
# celle-ci est une signature de defi. Les deux existent, aucun ne remplace
# l'autre. 16 caracteres minimum.
BROWSER_WORKER_TOKEN=

# ── Capacites ───────────────────────────────────────────────────────────────
# Vide = les quatre. Une liste explicite est le reglage recommande : un
# deploiement qui ne veut pas d'achat automatique retire browser.purchase, et
# la capacite n'est jamais annoncee au coeur.
WORKER_CAPABILITIES=browser.navigate,browser.interact

# Domaines navigables. Vide = pas de liste blanche ; les refus absolus du
# worker Python (boucle locale, plages privees RFC 1918, 169.254.169.254)
# s'appliquent de toute facon.
BROWSER_ALLOWED_DOMAINS=
BROWSER_PROHIBITED_DOMAINS=

# Etapes maximales d'une navigation. Une tache qui boucle coute des appels au
# modele et tient un Chromium ouvert.
BROWSER_MAX_STEPS=15

# Duree de vie d'une session navigateur inactive, cote worker Python.
BROWSER_SESSION_TTL_SECONDS=600

# `false` pour voir le navigateur. Utile au debogage, jamais en service.
BROWSER_HEADLESS=true

# ── Cycle de vie ────────────────────────────────────────────────────────────
WORKER_HEARTBEAT_INTERVAL_MS=30000
# Une navigation est longue : quinze minutes par defaut.
WORKER_TASK_TIMEOUT_MS=900000
# Un Chromium consomme de 300 Mo a 1 Go.
WORKER_MAX_CONCURRENT_TASKS=2

WORKER_RECONNECT_MIN_MS=2000
WORKER_RECONNECT_MAX_MS=120000

LOG_LEVEL=info

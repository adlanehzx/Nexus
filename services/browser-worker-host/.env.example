# ── NEXUS browser worker host ────────────────────────────────────────────────
# Copy to .env and fill it in. This file lists keys, never secret values.
#
# This process connects Browser Use to the NEXUS WorkerGateway. The Python
# worker owns browser-use and Chromium (ADR-006).

# ── Core connection ─────────────────────────────────────────────────────────
# A remote address must use wss://.
NEXUS_BACKEND_URL=wss://nexus.example.com

# Public identifier returned during pairing. It does not authenticate requests.
DEVICE_ID=00000000-0000-0000-0000-000000000000

# Path to the device's Ed25519 private key in PEM format. Never place the key
# itself in an environment variable, process listing, or container metadata.
DEVICE_KEY_PATH=/run/secrets/nexus-browser-device.pem

# ── Python worker connection ────────────────────────────────────────────────
# Internal network only. Never expose this worker to the Internet.
BROWSER_WORKER_URL=http://browser-worker:8100

# Python worker service token, separate from NEXUS challenge signing.
# Minimum length: 16 characters.
BROWSER_WORKER_TOKEN=

# ── Capabilities ────────────────────────────────────────────────────────────
# An explicit allowlist is recommended. Remove browser.purchase when automated
# purchases are not permitted.
WORKER_CAPABILITIES=browser.navigate,browser.interact

# Optional domain allowlist. Absolute network denials still apply.
BROWSER_ALLOWED_DOMAINS=
BROWSER_PROHIBITED_DOMAINS=

# Maximum navigation steps to bound model calls and browser lifetime.
BROWSER_MAX_STEPS=15

# Idle browser session lifetime in seconds.
BROWSER_SESSION_TTL_SECONDS=600

# Set to false only for interactive debugging.
BROWSER_HEADLESS=true

# ── Lifecycle ───────────────────────────────────────────────────────────────
WORKER_HEARTBEAT_INTERVAL_MS=30000
# Browser tasks may run for up to fifteen minutes by default.
WORKER_TASK_TIMEOUT_MS=900000
# Each Chromium instance may consume 300 MB to 1 GB.
WORKER_MAX_CONCURRENT_TASKS=2

WORKER_RECONNECT_MIN_MS=2000
WORKER_RECONNECT_MAX_MS=120000

LOG_LEVEL=info

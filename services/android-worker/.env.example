# ── NEXUS Android worker ────────────────────────────────────────────────────
# Copy to .env and fill it in. The device key remains in Android Keystore.

# NEXUS core. Remote connections must use wss://.
NEXUS_BACKEND_URL=wss://nexus.example.com/ws/worker

# Public device identifier returned during pairing.
DEVICE_ID=00000000-0000-0000-0000-000000000000

# Alias of the non-exportable ECDSA P-256 key in Android Keystore.
DEVICE_KEY_ALIAS=nexus.device.key

# Exposed capabilities. Empty means all capabilities whose permissions exist.
WORKER_CAPABILITIES=android.app.list,android.app.open,android.notification

# Applications that may be opened. An explicit allowlist is recommended.
ANDROID_ALLOWED_PACKAGES=com.spotify.music,com.google.android.apps.maps

# Additional package denials beyond the built-in protected list.
ANDROID_DENIED_PACKAGES=

# Coordinate clicks are disabled by default because screen contents can move.
ANDROID_ALLOW_COORDINATE_CLICKS=false

# Screenshot size and minimum interval bounds prevent continuous recording.
ANDROID_SCREENSHOT_MAX_DIMENSION=1280
ANDROID_SCREENSHOT_MIN_INTERVAL_MS=1000

# Low battery degrades routing; critical battery rejects new tasks.
ANDROID_LOW_BATTERY_PERCENT=20
ANDROID_CRITICAL_BATTERY_PERCENT=10

WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_TASK_TIMEOUT_MS=120000
# Keep UI automation serial on a phone.
WORKER_MAX_CONCURRENT_TASKS=1

WORKER_RECONNECT_MIN_MS=2000
WORKER_RECONNECT_MAX_MS=120000

# Capability availability check interval.
ANDROID_AVAILABILITY_INTERVAL_MS=30000

LOG_LEVEL=info

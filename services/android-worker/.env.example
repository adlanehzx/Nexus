# ── Worker Android NEXUS ────────────────────────────────────────────────────
# Copier en .env et renseigner. AUCUN SECRET NE FIGURE ICI : la cle de
# l'appareil est designee par un ALIAS dans le magasin de cles d'Android, et
# ne quitte jamais le telephone.

# Coeur NEXUS. Une adresse distante DOIT etre en wss:// — un telephone se
# connecte depuis n'importe quel reseau, y compris un point d'acces public.
NEXUS_BACKEND_URL=wss://nexus.exemple.fr/ws/worker

# Identifiant remis par le backend a l'appairage. Public : il n'authentifie rien.
DEVICE_ID=00000000-0000-0000-0000-000000000000

# Alias de la cle ECDSA P-256 dans le magasin de cles d'Android.
# Une REFERENCE, jamais la cle. Android ne gere pas Ed25519 dans son magasin
# materiel : P-256 est la seule courbe permettant une cle non extractible.
DEVICE_KEY_ALIAS=nexus.device.key

# Capacites exposees. Vide = toutes celles reellement disponibles.
# Une capacite n'est annoncee que si la permission Android correspondante est
# accordee ET qu'elle figure ici.
WORKER_CAPABILITIES=android.app.list,android.app.open,android.notification

# Applications ouvrables. Vide = toutes sauf celles refusees par la politique.
# Une liste explicite est le reglage recommande sur un telephone personnel.
ANDROID_ALLOWED_PACKAGES=com.spotify.music,com.google.android.apps.maps

# Refus supplementaires, en plus de la liste toujours interdite (reglages,
# installateur de paquets, portefeuilles, gestionnaires de mots de passe).
ANDROID_DENIED_PACKAGES=

# Clics par coordonnees. Faux par defaut : cliquer en (540, 1200) touche ce qui
# s'y trouve, pas ce qu'on visait.
ANDROID_ALLOW_COORDINATE_CLICKS=false

# Capture d'ecran : resolution maximale et intervalle minimal entre deux
# captures. L'intervalle est la barriere contre l'enregistrement continu par
# accumulation.
ANDROID_SCREENSHOT_MAX_DIMENSION=1280
ANDROID_SCREENSHOT_MIN_INTERVAL_MS=1000

# Batterie : sous le seuil bas l'appareil se declare DEGRADE (le selecteur
# l'evite), sous le seuil critique il refuse toute nouvelle tache.
ANDROID_LOW_BATTERY_PERCENT=20
ANDROID_CRITICAL_BATTERY_PERCENT=10

WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_TASK_TIMEOUT_MS=120000
# Un telephone ne mene pas trois automatisations d'interface de front.
WORKER_MAX_CONCURRENT_TASKS=1

WORKER_RECONNECT_MIN_MS=2000
WORKER_RECONNECT_MAX_MS=120000

# Periode de verification de la disponibilite des capacites.
ANDROID_AVAILABILITY_INTERVAL_MS=30000

LOG_LEVEL=info

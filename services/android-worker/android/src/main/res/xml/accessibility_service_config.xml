<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration du service d'accessibilité NEXUS.

  Chaque attribut ci-dessous élargit ce que le service peut voir ou faire. Ils
  sont donc réduits au strict nécessaire, et commentés un par un.

  Ce qui n'est PAS demandé :

    accessibilityEventTypes="typeAllMask"  — recevoir tous les événements
        d'interface reviendrait à observer en continu tout ce que l'utilisateur
        fait sur son téléphone. On demande `typeWindowStateChanged` seul, qui
        suffit à savoir qu'un écran a changé.

    flagRetrieveInteractiveWindows — l'accès aux fenêtres d'arrière-plan.
        Le worker agit sur l'écran actif, pas sur ce qui est masqué.

    canRequestFilterKeyEvents — l'interception des frappes clavier. C'est un
        enregistreur de frappe, quel que soit l'usage qu'on en fait.

    canRequestFingerprintGestures — sans objet ici.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"

    android:description="@string/accessibility_service_description"
    android:summary="@string/accessibility_service_summary"

    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"

    android:packageNames=""

    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews"

    android:canRetrieveWindowContent="true"

    android:canPerformGestures="true"

    android:canTakeScreenshot="true"

    android:notificationTimeout="100" />

<!--
  Notes sur les attributs retenus.

  flagReportViewIds
      Rend `findAccessibilityNodeInfosByViewId` utilisable. C'est ce qui permet
      de cibler un élément par son identifiant de vue — le sélecteur le plus
      stable, et celui que la politique préfère aux coordonnées.

  canRetrieveWindowContent
      Nécessaire pour trouver un élément avant d'agir dessus. Le service lit la
      hiérarchie de vues au moment de l'action et n'en conserve rien.

  canPerformGestures
      Nécessaire pour les gestes de défilement et, lorsque la configuration
      l'autorise explicitement, les appuis par coordonnées.

  canTakeScreenshot
      Active `AccessibilityService.takeScreenshot()` (Android 11+). C'est le
      mécanisme de capture de moindre privilège : une image, sur appel, sans
      MediaProjection ni flux vidéo. Voir le README pour la comparaison.

  packageNames=""
      Vide signifie « toutes les applications ». Restreindre ici serait
      préférable, mais la liste des applications que NEXUS peut piloter est un
      réglage utilisateur, appliqué à l'exécution par `AppPolicy` et
      `UiPolicy` — un manifeste ne se modifie pas sans réinstaller l'APK.
-->

<?xml version="1.0" encoding="utf-8"?>
<!--
  NEXUS Android worker manifest.

  This is the public list of powers the app may request. It deliberately omits
  QUERY_ALL_PACKAGES, notification access, audio, camera, SMS, contacts, and
  media projection. Launchable-app queries and accessibility screenshots provide
  the narrower capabilities the worker actually needs.
-->
<!--
  Android Gradle Plugin 8 reads the namespace from app/build.gradle.kts; repeating
  a package attribute here is a compilation error.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Outbound core connection only; no inbound port is opened. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Foreground service keeps the outbound connection alive with the screen off.
      Android requires a permanent notification so the worker remains visible.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Runtime notification permission on Android 13 and later. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reconnect automatically after device reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Explicitly remove the overlay permission added by React Native debug builds.
      Combining overlays with accessibility gestures would enable tapjacking.
    -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />

    <!--
      Android 11+ package visibility, limited to launchable applications instead
      of the broad QUERY_ALL_PACKAGES permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NexusWorkerApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Worker management screen, not the main NEXUS interface. -->
        <!--
          exported is required for the launcher activity. It consumes no intent data.
        -->
        <activity
            android:name=".WorkerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Accessibility service bound only by the system. It runs only after the
          user explicitly enables it in Android settings.
        -->
        <service
            android:name=".NexusAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Foreground connection service. dataSync is used because it synchronizes
          with the core and captures no video.
        -->
        <service
            android:name=".WorkerForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          exported is required for the protected BOOT_COMPLETED system broadcast.
          The receiver validates the action and only starts the service.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifeste du worker Android NEXUS.

  Ce fichier est la déclaration publique de tout ce que l'application peut
  demander au système. Il se lit comme une liste de pouvoirs, et c'est
  volontairement une liste courte : chaque ligne ajoutée élargit ce que NEXUS
  peut faire au téléphone.

  Ce qui ne s'y trouve PAS, et ne doit pas s'y trouver :

    QUERY_ALL_PACKAGES        — l'inventaire logiciel complet. Remplacé par un
                                <queries> sur les activités lançables, qui donne
                                exactement les applications ouvrables.
    BIND_NOTIFICATION_LISTENER_SERVICE — la lecture des notifications reçues.
    RECORD_AUDIO, CAMERA      — aucun usage ici.
    READ_SMS, READ_CONTACTS   — aucun usage ici.
    foregroundServiceType="mediaProjection" — la capture passe par le service
                                d'accessibilité, qui ne peut pas filmer.
-->
<!--
  L'attribut `package` ne figure volontairement pas ici : depuis le plugin Gradle
  Android 8, l'espace de noms est declare dans `app/build.gradle.kts`
  (`namespace = "fr.nexus.worker"`) et le repeter au manifeste est une erreur de
  compilation.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Connexion sortante vers le cœur. Aucun port entrant n'est ouvert. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Service de premier plan : maintient la connexion sortante quand l'écran
      est éteint. Android exige une notification permanente, ce qui est une
      bonne chose — l'utilisateur voit en permanence que le worker tourne.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Émettre des notifications. Permission d'exécution depuis Android 13. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reconnexion automatique après un redémarrage du téléphone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      RETRAIT explicite de la permission de dessiner par-dessus les autres
      applications.

      React Native l'ajoute a la variante de DEBOGAGE, pour son menu de
      developpement. Sur cette application elle est inacceptable : combinee au
      service d'accessibilite, elle permettrait de superposer une fenetre a
      celle d'une autre application pendant qu'un appui est simule — c'est
      exactement le montage d'une attaque par superposition.

      Le prix est connu et assume : le menu de developpement de React Native ne
      pourra pas s'afficher en surimpression. Cela ne coute rien a un worker qui
      n'a pas d'interface a mettre au point.
    -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />

    <!--
      Visibilité des paquets (Android 11+).

      Sans cette déclaration, `getInstalledPackages()` ne renvoie presque rien.
      Avec elle, l'application voit les applications **lançables** — exactement
      ce dont `android.app.list` et `android.app.open` ont besoin, et rien de
      plus. C'est l'alternative de moindre privilège à QUERY_ALL_PACKAGES.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NexusWorkerApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Écran de gestion du worker. Ce n'est pas l'interface NEXUS. -->
        <!--
          `exported="true"` parce qu'elle porte l'icone de lancement : sans cela
          l'utilisateur n'aurait aucun moyen d'ouvrir l'ecran de gestion, donc
          aucun moyen de voir ce qui manque au worker. Elle ne lit aucune donnee
          de l'intention qui la demarre : rien ne peut lui etre transmis.
        -->
        <activity
            android:name=".WorkerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Service d'accessibilité.

          `android:permission` restreint la liaison au système lui-même : aucune
          autre application ne peut s'y connecter. Il n'est actif que si
          l'utilisateur l'a explicitement activé dans les réglages — aucune API
          ne permet de l'activer par programme, et ce worker ne cherche pas à
          contourner cette règle.
        -->
        <service
            android:name=".NexusAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Service de premier plan qui porte la connexion.

          `dataSync` et non `mediaProjection` : ce service synchronise des
          données avec le cœur, il ne filme rien.
        -->
        <service
            android:name=".WorkerForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          `exported="true"` est requis pour recevoir une diffusion du systeme.
          `BOOT_COMPLETED` est une diffusion PROTEGEE : seul le systeme peut
          l'emettre, aucune application tierce ne le peut. Le recepteur verifie
          malgre tout l'action recue, et ne fait qu'une chose — demarrer le
          service. Il n'execute jamais de capacite.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

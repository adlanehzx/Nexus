{
  "profiles": {
    "antigravity": {
      "name": "Antigravity",
      "command": "${HOME}/.local/share/mise/shims/npx",
      "args": [
        "-y",
        "--prefer-offline",
        "google-antigravity-acp@2.0.1",
        "--binary-path",
        "${HOME}/.local/bin/agy",
        "--no-skip-permissions"
      ]
    },
    "claude": {
      "name": "Claude",
      "command": "${HOME}/.local/share/mise/shims/npx",
      "args": ["-y", "--prefer-offline", "@agentclientprotocol/claude-agent-acp@0.63.0"],
      "model": "claude-opus-5"
    },
    "codex": {
      "name": "Codex",
      "command": "${HOME}/.local/share/mise/shims/npx",
      "args": ["-y", "--prefer-offline", "@agentclientprotocol/codex-acp@1.10.0"],
      "model": "gpt-5.6-sol"
    }
  }
}

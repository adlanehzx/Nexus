{
  "name": "nexus",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "NEXUS — local multi-device AI assistant",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:pg": "pnpm --filter @nexus/api test:pg",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/check-release-hygiene.mjs",
    "verify": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "nexus": "node packages/cli/dist/index.js",
    "db:generate": "pnpm --filter @nexus/database generate",
    "db:migrate": "pnpm --filter @nexus/database migrate",
    "db:studio": "pnpm --filter @nexus/database studio",
    "docker:build": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env build",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env up -d",
    "docker:infra": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env up -d postgres redis",
    "docker:platform": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env up -d postgres redis migrate api dashboard",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env down",
    "docker:logs": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env logs -f",
    "clean": "turbo run clean && rimraf node_modules",
    "docker:browser": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env --profile browser up -d browser-worker",
    "docker:research": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env --profile research up -d searxng",
    "docker:observability": "OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318 docker compose -f infrastructure/docker/docker-compose.yml --env-file .env --profile observability up -d",
    "k8s:images": "docker build -f infrastructure/docker/api.Dockerfile -t nexus-api:local . && docker build -f infrastructure/docker/dashboard.Dockerfile -t nexus-dashboard:local . && docker build -f infrastructure/docker/migrate.Dockerfile -t nexus-migrate:local .",
    "worker:image": "docker build -f infrastructure/docker/worker.Dockerfile -t nexus-worker:local .",
    "k8s:render": "kubectl kustomize infrastructure/kubernetes",
    "translation:status": "bash scripts/translation-status.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  }
}

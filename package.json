{
  "name": "nexus",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS \u00e2\u20ac\u201d assistant personnel IA multi-appareils",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:pg": "pnpm --filter @nexus/api test:pg",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @nexus/database generate",
    "db:migrate": "pnpm --filter @nexus/database migrate",
    "db:studio": "pnpm --filter @nexus/database studio",
    "docker:build": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env build",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env down",
    "docker:logs": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env logs -f",
    "clean": "turbo run clean && rimraf node_modules",
    "docker:browser": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env --profile browser up -d browser-worker"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "rimraf": "6.0.1",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}

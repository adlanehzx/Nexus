# ─────────────────────────────────────────────────────────────────────────────
# NEXUS — variables d'environnement
#
# Copier en `.env` et remplir. Ce fichier liste les CLÉS, jamais les VALEURS.
# Toute variable est validée au démarrage par @nexus/config : une valeur manquante
# ou mal typée empêche le boot, elle n'échoue pas silencieusement en production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ── API ──────────────────────────────────────────────────────────────────────
# Version exposée par /api/v1/health. Le pipeline de déploiement y injecte
# habituellement le SHA du commit.
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=3000
# Origines autorisées, séparées par des virgules. "*" est refusé en production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Délai maximal laissé aux connexions en cours lors d'un arrêt gracieux.
SHUTDOWN_TIMEOUT_MS=10000
# Limitation de débit par IP.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ── Observabilité ────────────────────────────────────────────────────────────
# Le port Prometheus reste lié à la boucle locale hors Docker.
METRICS_ENABLED=true
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
OTEL_SERVICE_NAME=nexus-api
# Laisser vide pour désactiver l'export de traces OTLP.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Coût API équivalent par million de jetons. Avec les abonnements CLI, ce n'est
# pas une facture réelle et aucune valeur n'est inventée par défaut.
# MODEL_PRICING_JSON={"nom-du-modele":{"inputPerMillionUsd":0,"outputPerMillionUsd":0}}
# Identifiants Grafana local. Changer le mot de passe hors développement.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=nexus-local-observability
GRAFANA_PORT=3300
PROMETHEUS_PORT=9090

# ── Mémoire sémantique locale ────────────────────────────────────────────────
# `neural` exécute le modèle ONNX en local, sans clé ni envoi de texte.
MEMORY_EMBEDDING_BACKEND=neural
MEMORY_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# Premier lancement : téléchargement dans ce cache. Une fois rempli, activer le
# mode hors ligne strict avec MEMORY_EMBEDDING_LOCAL_ONLY=true.
MEMORY_EMBEDDING_CACHE_DIR=.cache/nexus/transformers
MEMORY_EMBEDDING_LOCAL_ONLY=false

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Utilisé par Prisma et par le healthcheck de readiness.
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus?schema=public

# Consommées uniquement par docker compose pour initialiser le conteneur.
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_DB=nexus

# ── Redis ────────────────────────────────────────────────────────────────────
# Sessions temporaires, files de jobs, cache, pub/sub.
REDIS_URL=redis://localhost:6379

# ── NEXUS Mission Engine ────────────────────────────────────────────────────
# Laisser vide pour désactiver. HTTP n'est accepté qu'en boucle locale.
MISSION_CONTROL_URL=http://127.0.0.1:18100

# Cle de signature Ed25519 (PEM PKCS8), sur une seule ligne avec des \n
# echappes. Sans elle, une cle ephemere est generee a chaque demarrage : les
# sessions ne survivent alors pas a un redemarrage, et la cle publique ne peut
# pas etre provisionnee sur Mission Engine -- donc l'authentification des
# appels API -> moteur reste inactive.
#
# Generer la paire :
#   node -e 'const{generateKeyPairSync}=require("node:crypto");\
#     const{privateKey,publicKey}=generateKeyPairSync("ed25519");\
#     console.log(JSON.stringify(privateKey.export({type:"pkcs8",format:"pem"}).toString()));\
#     require("node:fs").writeFileSync("nexus-api-public.pem",publicKey.export({type:"spki",format:"pem"}))'
#
# Reporter la chaine JSON produite ici, et le fichier `nexus-api-public.pem`
# dans `NEXUS_ENGINE_API_PUBLIC_KEY_FILE` cote moteur.
# AUTH_SIGNING_KEY=

# Recherche web locale, sans clé API. En lancement Docker, utiliser
# http://searxng:8080 et démarrer le profil `pnpm docker:research`. Pour une API
# lancée sur l'hôte, publier explicitement SearXNG sur la boucle locale ou
# utiliser une instance HTTPS privée.
# SEARXNG_URL=
# SEARXNG_TIMEOUT_MS=15000
# SEARXNG_SECRET=genere-au-premier-deploiement

# ─────────────────────────────────────────────────────────────────────────────
# Ajoutées aux phases suivantes — présentes ici pour mémoire, PAS encore validées.
# Ne pas décommenter tant que le code correspondant n'existe pas.
# ─────────────────────────────────────────────────────────────────────────────

# Phase 1 — authentification
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d

# Phase 1 — fournisseur LLM (cf. ADR-004 : jamais lu hors des adaptateurs)
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=

# Phase 2 — coffre à secrets utilisateur (cf. ADR-013)
# Clé racine du chiffrement enveloppe. Sa perte rend les credentials irrécupérables :
# la sauvegarder hors ligne, dans un gestionnaire de mots de passe.
# MASTER_KEY=

# Phase 5 — Browser Use worker
# BROWSER_WORKER_URL=http://localhost:8100
# BROWSER_WORKER_TOKEN=

# Phase 7 — voix
# STT_PROVIDER=
# TTS_PROVIDER=

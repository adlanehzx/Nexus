# NEXUS environment template
# Copy this file to `.env`. It documents keys and safe development defaults;
# never commit real credentials.

# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# API
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=3000
# The containerized dashboard proxies /api and /ws to the Core.
DASHBOARD_PORT=8080
# Comma-separated allowed origins. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5274,http://localhost:8081
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Observability
METRICS_ENABLED=true
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
OTEL_SERVICE_NAME=nexus-api
# Leave empty to disable OTLP trace export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# API-equivalent cost per million tokens. CLI subscriptions are not billed this
# way, so NEXUS does not invent a default price.
# MODEL_PRICING_JSON={"model-name":{"inputPerMillionUsd":0,"outputPerMillionUsd":0}}
GRAFANA_ADMIN_USER=admin
# Development only. Replace this value outside a loopback-only installation.
GRAFANA_ADMIN_PASSWORD=nexus-local-observability
GRAFANA_PORT=3300
PROMETHEUS_PORT=9090

# Local semantic memory
MEMORY_EMBEDDING_BACKEND=neural
MEMORY_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_EMBEDDING_CACHE_DIR=.cache/nexus/transformers
MEMORY_EMBEDDING_LOCAL_ONLY=false

# PostgreSQL
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus?schema=public
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_DB=nexus

# Redis
REDIS_URL=redis://localhost:6379

# Mission Engine. Plain HTTP is accepted only on loopback.
MISSION_CONTROL_URL=http://127.0.0.1:18100

# Local voice (optional)
# NEXUS_WHISPER_MODEL=~/.nexus/models/ggml-base.bin
# NEXUS_PIPER_VOICE=~/.nexus/voices/en_US-lessac-medium.onnx

# Advisory worker version. NEXUS intentionally has no remote-code-update
# channel; upgrades remain a local package-manager or installer operation.
# EXPECTED_WORKER_VERSION=0.1.0

# Address reachable by phones and remote workers. Required for pairing. Do not
# use localhost: on a phone it points back to the phone itself. HTTPS is
# required outside loopback or a private network.
# PUBLIC_API_URL=https://nexus.example.com

# Persistent container paths. Leave unset for repository-local development.
# NEXUS_RUNTIME_CONFIG_DIR=/var/lib/nexus/runtime-config
# NEXUS_BROWSER_ARTIFACTS_DIR=/var/lib/nexus/artifacts/browser
# NEXUS_OBSERVABILITY_DIR=/var/lib/nexus/observability

# Persistent Ed25519 PKCS8 private key encoded on one line with escaped `\n`.
# `nexus setup` generates this value and stores the public key outside the
# repository. Never paste it into an issue or commit it.
# AUTH_SIGNING_KEY=

# Local web search without a paid API key.
# SEARXNG_URL=http://searxng:8080
# SEARXNG_TIMEOUT_MS=15000
# SEARXNG_SECRET=replace-with-a-random-value

# Optional integrations. Keep disabled until the corresponding adapter is in
# use, and store user secrets in the NEXUS vault whenever possible.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=
# MASTER_KEY=
# BROWSER_WORKER_URL=http://localhost:8100
# BROWSER_WORKER_TOKEN=
# STT_PROVIDER=
# TTS_PROVIDER=

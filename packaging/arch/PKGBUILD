# Paquet Arch Linux de la coquille NEXUS.
#
# Construit depuis les sources, et non depuis un binaire téléchargé : sur Arch,
# un paquet qui embarque un binaire opaque est exactement ce qu'on ne veut pas
# installer, et le dépôt est de toute façon la source.
#
# Usage :
#   cd packaging/arch && makepkg -si
#
# `pkgver` est remplacé par la version de `apps/desktop/src-tauri/tauri.conf.json`
# au moment de la publication ; la valeur ici est celle du dépôt.
pkgname=nexus-desktop
pkgver=1.0.0
pkgrel=1
pkgdesc="Assistant personnel local NEXUS — coquille de bureau"
arch=('x86_64')
url="https://github.com/adlanehzx/Nexus"
license=('UNLICENSED')

# webkit2gtk-4.1 et gtk3 sont les dépendances réelles de la coquille. Les
# déclarer évite le pire : un paquet qui s'installe puis refuse de démarrer.
depends=('webkit2gtk-4.1' 'gtk3' 'libappindicator-gtk3' 'librsvg')
makedepends=('rust' 'cargo' 'nodejs>=24' 'pnpm' 'git')

# Pas de `source=()` : ce PKGBUILD se construit depuis l'arbre courant.
# Un paquet officiel utiliserait une archive signée ; ici l'arbre *est* la
# source, et prétendre le contraire compliquerait sans rien garantir.
options=('!strip' '!debug')

build() {
  cd "$startdir/../.."
  pnpm install --frozen-lockfile
  pnpm build
  pnpm --filter @nexus/desktop exec tauri build --bundles deb
}

package() {
  cd "$startdir/../.."
  local bundle="apps/desktop/src-tauri/target/release/bundle"

  # On réutilise le contenu du paquet Debian produit par Tauri plutôt que de
  # réimplémenter l'arborescence : deux descriptions du même agencement
  # finiraient par ne plus coïncider.
  install -Dm755 "$bundle/deb/"*/data/usr/bin/NEXUS "$pkgdir/usr/bin/nexus-desktop"
  install -Dm644 "$bundle/deb/"*/data/usr/share/applications/*.desktop \
    "$pkgdir/usr/share/applications/nexus-desktop.desktop"

  for size in 32x32 128x128 256x256; do
    install -Dm644 "apps/desktop/src-tauri/icons/$size.png" \
      "$pkgdir/usr/share/icons/hicolor/$size/apps/nexus-desktop.png"
  done
}

# Files that do not belong in the build context.
**/node_modules
**/dist
**/.turbo
**/coverage
**/src/generated
var
backups
services/mission-engine/var
# Personal settings written by the dashboard: session paths, provider accounts,
# and secret references. They live in a runtime volume and must never enter an
# image layer.
services/api/config
.git
.github
docs
# The dashboard has its own image. Other native clients do not belong in server
# image build contexts.
apps/*
!apps/dashboard
!apps/dashboard/**
!services/windows-worker/**
services/agent
services/browser-worker
**/*.md
**/.env
**/.env.*
!**/.env.example
**/*.log
**/.DS_Store

{
  "annotations": { "list": [] },
  "editable": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum(rate(nexus_http_requests_total[5m]))", "refId": "A" }],
      "title": "API requests per second",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(nexus_agent_run_duration_seconds_bucket[5m])))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ],
      "title": "Latence p95 des agents",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (agent, status) (increase(nexus_agent_runs_total[1h]))",
          "legendFormat": "{{agent}} · {{status}}",
          "refId": "A"
        }
      ],
      "title": "Runs par agent et statut",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "showTime": true, "wrapLogMessage": true },
      "targets": [{ "expr": "{job=\"nexus-docker\"} | json", "refId": "A" }],
      "title": "NEXUS logs",
      "type": "logs"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": ["nexus"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "NEXUS · Vue d’ensemble",
  "uid": "nexus-overview",
  "version": 1
}

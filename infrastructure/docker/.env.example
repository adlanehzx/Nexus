# NEXUS Infrastructure Secrets Configuration
# WARNING: Never commit production private keys or master encryption keys in plaintext.
# Generate dynamic cryptographic secrets using:
#   bash generate-keys.sh
# Or manually with openssl:
#   AUTH_SIGNING_KEY: openssl genpkey -algorithm ed25519 -outform PEM | awk '{printf "%s\\n", $0}'
#   MASTER_KEY:       openssl rand -hex 32

AUTH_SIGNING_KEY="<GENERATE_WITH_OPENSSL_OR_SCRIPT>"
MASTER_KEY="<GENERATE_WITH_OPENSSL_OR_SCRIPT>"

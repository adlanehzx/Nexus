{
  "name": "@nexus/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "NEXUS mobile client (Expo and Expo Router)",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf .expo .turbo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@nexus/client-core": "workspace:*",
    "@nexus/design": "workspace:*",
    "@nexus/protocol": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-speech": "~57.0.2",
    "expo-speech-recognition": "~57.1.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}

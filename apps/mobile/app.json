{
  "expo": {
    "name": "NEXUS",
    "slug": "nexus",
    "scheme": "nexus",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.nexus.client",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NEXUS uses the microphone only while you press the microphone button to dictate a message. It never listens continuously.",
        "NSSpeechRecognitionUsageDescription": "NEXUS transcribes speech only while you dictate a message for the assistant.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.nexus.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08101d"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#08101d"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": { "router": {} }
  }
}

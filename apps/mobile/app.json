{
  "expo": {
    "name": "NEXUS",
    "slug": "nexus",
    "scheme": "nexus",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.nexus.client",
      "infoPlist": {
        "NSFaceIDUsageDescription": "NEXUS uses Face ID to unlock the app and confirm remote control actions when you enable it.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.nexus.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08101d"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "NEXUS uses the microphone only while you press the microphone button to dictate a message. It never listens continuously.",
          "speechRecognitionPermission": "NEXUS transcribes speech only while you dictate a message for the assistant.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#08101d"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#08101d"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": { "router": {} }
  }
}

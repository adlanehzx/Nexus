{
  "name": "@nexus/client-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Platform-independent NEXUS client core for sessions, realtime state and voice",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/mobile.d.ts",
        "default": "./dist/mobile.js"
      },
      "react-native": {
        "types": "./dist/mobile.d.ts",
        "default": "./dist/mobile.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "default": "./dist/mobile.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@nexus/protocol": "workspace:*",
    "@nexus/shared": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "vitest": "4.1.11"
  }
}

// NEXUS — Data schema
// Full reference: docs/architecture/07-data-model.md
//
// Convention: IDs are UUID v7 generated on the application side
// (`uuidv7()` from @nexus/shared) — time-sortable without index fragmentation,
// and unguessable. No SQL default is declared: IDs are decided by application logic.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// As of Prisma 7, connection URL is read from `prisma.config.ts` by migrations,
// and passed via driver adapter to the client (cf. src/client.ts).
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id          String     @id @db.Uuid
  email       String     @unique
  displayName String
  locale      String     @default("fr")
  timezone    String     @default("Europe/Paris")
  status      UserStatus @default(ACTIVE)
  role        String     @default("USER")
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  authCredential AuthCredential?
  sessions       Session[]
  devices        Device[]
  conversations  Conversation[]
  memories       Memory[]
  notifications  Notification[]
  agentRuns      AgentRunSnapshot[]
  scheduleGrants ScheduleGrant[]

  @@map("users")
}

/// Decoupled from User so fetching user data never fetches password hashes.
model AuthCredential {
  id           String   @id @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

/// Authentication session — distinct from conversation.
/// Refresh tokens are stored hashed; reuse after rotation triggers family revocation.
model Session {
  id               String    @id @db.Uuid
  userId           String    @db.Uuid
  deviceId         String?   @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime  @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@map("sessions")
}

enum DevicePlatform {
  WINDOWS
  MACOS
  LINUX
  IOS
  ANDROID
  WEB
}

/// Device kind. `BROWSER_WORKER` is included because Browser Use acts as a full worker.
enum DeviceType {
  IPHONE
  ANDROID
  WINDOWS_PC
  MAC
  LINUX
  BROWSER_WORKER
}

/// Allowed device role. `BOTH` allows desktop/laptops to serve as client and worker.
enum DeviceRole {
  CLIENT
  WORKER
  BOTH
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  DEGRADED
  REVOKED
}

/// Distinct from status: a device can be online without being trusted yet (PENDING).
enum TrustState {
  PENDING
  TRUSTED
  REVOKED
}

/// Registered device: client, worker, or both.
model Device {
  id                 String         @id @db.Uuid
  userId             String         @db.Uuid
  name               String
  type               DeviceType
  platform           DevicePlatform
  role               DeviceRole
  status             DeviceStatus   @default(OFFLINE)
  trust              TrustState     @default(PENDING)
  agentVersion       String?
  /// Health reported on last heartbeat: load, battery, latency, active tasks.
  health             Json           @default("{\"activeTasks\":0,\"maxConcurrentTasks\":1}")
  /// Explicit permissions granted to THIS DEVICE in addition to user permissions.
  grantedPermissions String[]       @default([])
  metadata           Json           @default("{}")
  lastSeenAt         DateTime?      @db.Timestamptz(3)
  pairedAt           DateTime       @default(now()) @db.Timestamptz(3)
  revokedAt          DateTime?      @db.Timestamptz(3)

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        Session[]
  capabilities    DeviceCapability[]
  credentials     DeviceCredential[]
  deviceSessions  DeviceSession[]
  executions      TaskExecution[]
  originatedTasks TaskPlan[]         @relation("TaskOrigin")

  @@index([userId, role, status])
  @@index([userId, trust])
  @@map("devices")
}

/// Capability declared by a worker.
/// Normalized row-per-capability for indexing and independent enable/disable toggles.
model DeviceCapability {
  id          String   @id @db.Uuid
  deviceId    String   @db.Uuid
  name        String
  version     String   @default("1")
  description String   @default("")
  /// JSON schema for capability arguments as declared by worker.
  inputSchema Json?
  enabled     Boolean  @default(true)
  metadata    Json     @default("{}")
  declaredAt  DateTime @default(now()) @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, name])
  @@index([name, enabled])
  @@map("device_capabilities")
}

enum DeviceCredentialKind {
  ED25519_PUBLIC_KEY
  ECDSA_P256_PUBLIC_KEY
  SERVICE_TOKEN_HASH
}

/// Device authentication credential. Public key or token hash, never raw private keys.
model DeviceCredential {
  id        String               @id @db.Uuid
  deviceId  String               @db.Uuid
  kind      DeviceCredentialKind
  material  String
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  rotatedAt DateTime?            @db.Timestamptz(3)
  expiresAt DateTime?            @db.Timestamptz(3)
  revokedAt DateTime?            @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, revokedAt])
  @@map("device_credentials")
}

/// Authenticated device session. Distinct from user session.
model DeviceSession {
  id              String    @id @db.Uuid
  deviceId        String    @db.Uuid
  userId          String    @db.Uuid
  /// Token hash. Returned once upon issuance.
  tokenHash       String    @unique
  issuedAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime  @db.Timestamptz(3)
  lastHeartbeatAt DateTime  @default(now()) @db.Timestamptz(3)
  rotatedFromId   String?   @db.Uuid
  revokedAt       DateTime? @db.Timestamptz(3)
  /// Negotiated capabilities for this session, bounded by device capabilities.
  capabilities    String[]  @default([])
  remoteAddress   String?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, revokedAt])
  @@index([expiresAt])
  @@map("device_sessions")
}

enum TaskPlanStatus {
  PENDING
  RUNNING
  WAITING_FOR_CONFIRMATION
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIAL
}

enum TaskStepStatus {
  PENDING
  READY
  ASSIGNED
  RUNNING
  WAITING_FOR_CONFIRMATION
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

/// Distributed multi-device execution plan.
model TaskPlan {
  id                   String         @id @db.Uuid
  userId               String         @db.Uuid
  title                String
  /// Origin client device where request was initiated.
  originClientDeviceId String         @db.Uuid
  runId                String?        @db.Uuid
  conversationId       String?        @db.Uuid
  correlationId        String
  status               TaskPlanStatus @default(PENDING)
  metadata             Json           @default("{}")
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  startedAt            DateTime?      @db.Timestamptz(3)
  completedAt          DateTime?      @db.Timestamptz(3)

  originClient Device     @relation("TaskOrigin", fields: [originClientDeviceId], references: [id], onDelete: Cascade)
  steps        TaskStep[]

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([originClientDeviceId])
  @@map("task_plans")
}

/// Plan step. `requiredCapabilities` decides worker selection; `selectedDeviceId` assigned at runtime.
model TaskStep {
  id                   String         @id @db.Uuid
  taskId               String         @db.Uuid
  /// Readable identifier within the plan (`clone`, `test`...).
  key                  String
  description          String
  requiredCapabilities String[]
  tool                 String
  arguments            Json           @default("{}")
  dependsOn            String[]       @default([])
  selectedDeviceId     String?        @db.Uuid
  preferredDeviceId    String?        @db.Uuid
  constraints          Json?
  riskLevel            String         @default("MEDIUM")
  retryPolicy          Json           @default("{\"attempts\":1,\"backoffMs\":1000,\"failoverToAnotherDevice\":false}")
  timeoutMs            Int            @default(300000)
  status               TaskStepStatus @default(PENDING)
  attempt              Int            @default(0)
  result               Json?
  error                Json?
  startedAt            DateTime?      @db.Timestamptz(3)
  completedAt          DateTime?      @db.Timestamptz(3)

  plan       TaskPlan        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  executions TaskExecution[]

  @@unique([taskId, key])
  @@index([taskId, status])
  @@map("task_steps")
}

/// Execution attempt of a step on a designated device.
model TaskExecution {
  id          String         @id @db.Uuid
  taskId      String         @db.Uuid
  stepId      String         @db.Uuid
  deviceId    String         @db.Uuid
  attempt     Int
  status      TaskStepStatus
  startedAt   DateTime       @default(now()) @db.Timestamptz(3)
  completedAt DateTime?      @db.Timestamptz(3)
  durationMs  Int?
  /// Redacted arguments: zero secrets in audit logs.
  input       Json?
  result      Json?
  error       Json?

  step   TaskStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  device Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
  @@index([deviceId, startedAt(sort: Desc)])
  @@map("task_executions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Conversation
// ─────────────────────────────────────────────────────────────────────────────

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

model Conversation {
  id            String             @id @db.Uuid
  userId        String             @db.Uuid
  title         String?
  status        ConversationStatus @default(ACTIVE)
  pinnedAt      DateTime?          @db.Timestamptz(3)
  lastMessageAt DateTime?          @db.Timestamptz(3)
  tokenCount    Int                @default(0)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

/// `content` is an array of typed content blocks (text, tool_call, tool_result, image, audio).
/// `contentText` is the flattened text projection for full-text search.
model Message {
  id                   String      @id @db.Uuid
  conversationId       String      @db.Uuid
  role                 MessageRole
  content              Json
  contentText          String      @default("")
  originClientDeviceId String?     @db.Uuid
  runId                String?     @db.Uuid
  tokensIn             Int         @default(0)
  tokensOut            Int         @default(0)
  model                String?
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  editedAt             DateTime?   @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum MemoryLayer {
  LONG_TERM
  PREFERENCE
}

enum MemoryKind {
  SEMANTIC
  EPISODIC
  PROCEDURAL
}

enum MemoryOrigin {
  USER
  AGENT
  SYSTEM
}

enum MemorySensitivity {
  ORDINARY
  PERSONAL
}

model Memory {
  id                   String                      @id @db.Uuid
  userId               String                      @db.Uuid
  layer                MemoryLayer                 @default(LONG_TERM)
  kind                 MemoryKind
  content              String
  importance           Float
  confidence           Float
  tags                 String[]                    @default([])
  origin               MemoryOrigin                @default(USER)
  sensitivity          MemorySensitivity           @default(ORDINARY)
  sensitiveCategories  String[]                    @default([])
  /// Explicit provenance pointers without duplicating sensitive source raw text.
  sourceRunId          String?                     @db.Uuid
  sourceConversationId String?                     @db.Uuid
  sourceMessageId      String?                     @db.Uuid
  sourceUri            String?
  /// Normalized content hash for deduplication.
  contentHash          String
  /// Array copy used by Prisma and portable exports.
  embedding            Float[]                     @default([])
  embeddingVector      Unsupported("vector(384)")? @map("embedding_vector")
  embeddingModel       String?
  extractedAt          DateTime?                   @db.Timestamptz(3)
  validFrom            DateTime                    @db.Timestamptz(3)
  validUntil           DateTime?                   @db.Timestamptz(3)
  supersededById       String?                     @db.Uuid
  supersedesId         String?                     @db.Uuid
  createdAt            DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @db.Timestamptz(3)

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supersededBy       Memory?  @relation("MemorySupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)
  supersededRecords  Memory[] @relation("MemorySupersededBy")
  supersedes         Memory?  @relation("MemorySupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersedingRecords Memory[] @relation("MemorySupersedes")

  @@index([userId, layer, validUntil])
  @@index([userId, kind, validUntil])
  @@index([userId, validFrom(sort: Desc)])
  @@index([userId, contentHash, validUntil])
  @@index([sourceRunId])
  @@map("memories")
}

model Notification {
  id                   String    @id @db.Uuid
  userId               String    @db.Uuid
  title                String
  body                 String
  severity             String
  originClientDeviceId String?   @db.Uuid
  readAt               DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Registry of issued mission grant assertions.
model DevicePairingTicket {
  id         String    @id @db.Uuid
  userId     String    @db.Uuid
  /// SHA-256 of code in hex. Unique constraint guarantees one ticket per code.
  codeHash   String    @unique @db.Char(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  /// Null while unused; timestamp enforces single-use.
  consumedAt DateTime? @db.Timestamptz(3)
  /// Device created by this pairing ticket.
  deviceId   String?   @db.Uuid
  label      String?   @db.VarChar(120)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("device_pairing_tickets")
}

model MissionGrant {
  /// The `jti` of the assertion.
  id                 String            @id @db.Uuid
  missionExternalKey String            @db.VarChar(128)
  userId             String            @db.Uuid
  service            String            @db.VarChar(64)
  issuedAt           DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt          DateTime          @db.Timestamptz(3)
  status             MissionGrantState @default(ACTIVE)
  /// Retirement timestamp. Null while active.
  retiredAt          DateTime?         @db.Timestamptz(3)

  @@index([missionExternalKey, status])
  @@index([userId, status])
  @@index([expiresAt])
  @@map("mission_grants")
}

enum MissionGrantState {
  ACTIVE
  /// Retired because mission completed or cancelled. Normal flow.
  COMPLETED
  /// Revoked due to incident/mistrust.
  REVOKED
}

/// Long-lived revocable delegation grant.
model ScheduleGrant {
  id                 String             @id @db.Uuid
  tokenHash          String             @unique @db.Char(64)
  userId             String             @db.Uuid
  missionExternalKey String             @db.VarChar(128)
  scheduleId         String             @unique @db.Uuid
  status             ScheduleGrantState @default(ACTIVE)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  revokedAt          DateTime?          @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("schedule_grants")
}

enum ScheduleGrantState {
  ACTIVE
  REVOKED
}

/// Agent Core run claim for task attempts.
/// Unique constraint on (mission, task, attempt) prevents concurrent double runs.
model AgentCoreRunClaim {
  id                 String   @id @db.Uuid
  missionExternalKey String   @db.VarChar(128)
  taskKey            String   @db.VarChar(128)
  attemptId          String   @db.VarChar(128)
  runId              String   @db.Uuid
  userId             String   @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@unique([missionExternalKey, taskKey, attemptId])
  @@index([runId])
  @@map("agent_core_run_claims")
}

model AgentRunSnapshot {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  status    String
  startTime DateTime @db.Timestamptz(3)
  state     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Mission that requested this run. Null for interactive runs initiated by a user.
  missionExternalKey String? @db.VarChar(128)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startTime(sort: Desc)])
  @@index([status])
  @@index([missionExternalKey])
  @@map("agent_run_snapshots")
}

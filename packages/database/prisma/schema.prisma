// NEXUS — Data schema
// Full reference: docs/architecture/07-data-model.md
//
// Convention: IDs are UUID v7 generated on the application side
// (`uuidv7()` from @nexus/shared) — time-sortable without index fragmentation,
// and unguessable. No SQL default is declared: IDs are decided by application logic.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// As of Prisma 7, connection URL is read from `prisma.config.ts` by migrations,
// and passed via driver adapter to the client (cf. src/client.ts).
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id          String     @id @db.Uuid
  email       String     @unique
  displayName String
  locale      String     @default("fr")
  timezone    String     @default("Europe/Paris")
  status      UserStatus @default(ACTIVE)
  role        String     @default("USER")
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  authCredential          AuthCredential?
  sessions                Session[]
  devices                 Device[]
  conversations           Conversation[]
  memories                Memory[]
  notifications           Notification[]
  agentRuns               AgentRunSnapshot[]
  scheduleGrants          ScheduleGrant[]
  organizationMemberships OrganizationMembership[]
  teamMemberships         TeamMembership[]

  /// Career and education. Every row cascades on account deletion: this is the
  /// owner's own job search, and retention follows the account, not the table.
  careerProfile            CareerProfile?
  careerOpportunities      CareerOpportunity[]
  careerApplications       CareerApplication[]
  careerDocumentVariants   CareerDocumentVariant[]
  careerContacts           CareerContact[]
  careerDeadlines          CareerDeadline[]
  careerInterviews         CareerInterview[]
  careerOutcomes           CareerOutcome[]
  careerFollowUps          CareerFollowUp[]
  careerSubmissionAttempts CareerSubmissionAttempt[]
  careerConfirmations      CareerConfirmation[]
  careerApplicationEvents  CareerApplicationEvent[]

  @@map("users")
}

/// Tenant root. Personal mode creates one implicit LOCAL organization on demand.
model Organization {
  id        String   @id @db.Uuid
  slug      String   @unique
  name      String
  mode      String   @default("HOSTED")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships       OrganizationMembership[]
  teams             Team[]
  identityProviders OrganizationIdentityProvider[]
  quotas            OrganizationQuota[]
  missionGrants     MissionAccessGrant[]
  usageRecords      BillingUsageRecord[]
  fleet             FleetInstallation[]
  collaboration     OrganizationCollaborationEvent[]
  artifacts         OrganizationArtifact[]

  @@map("organizations")
}

model OrganizationMembership {
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId, organizationId])
  @@map("organization_memberships")
}

model Team {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  TeamMembership[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("teams")
}

model TeamMembership {
  organizationId String   @db.Uuid
  teamId         String   @db.Uuid
  userId         String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  team Team @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, teamId, userId])
  @@index([organizationId, userId])
  @@map("team_memberships")
}

model OrganizationIdentityProvider {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  protocol       String
  issuer         String
  clientId       String
  metadata       Json     @default("{}")
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, protocol, issuer])
  @@index([organizationId, id])
  @@map("organization_identity_providers")
}

model OrganizationQuota {
  organizationId String   @db.Uuid
  key            String
  limit          BigInt
  used           BigInt   @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
  @@map("organization_quotas")
}

model MissionAccessGrant {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  missionId      String
  principalType  String
  principalId    String
  permission     String
  createdBy      String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, missionId, principalType, principalId, permission])
  @@index([organizationId, missionId])
  @@map("mission_access_grants")
}

model BillingUsageRecord {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  provider       String
  metric         String
  quantity       BigInt
  costMicrounits BigInt?
  official       Boolean
  occurredAt     DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@map("billing_usage_records")
}

model FleetInstallation {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  installationId String
  displayName    String
  status         String
  capabilities   String[] @default([])
  lastSeenAt     DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, installationId])
  @@index([organizationId, status])
  @@map("fleet_installations")
}

model OrganizationCollaborationEvent {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  channelId      String
  actorUserId    String   @db.Uuid
  sequence       Int
  kind           String
  payload        Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channelId, sequence])
  @@index([organizationId, channelId, createdAt])
  @@map("organization_collaboration_events")
}

model OrganizationArtifact {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  missionId      String
  artifactKey    String
  uri            String
  sha256         String
  createdBy      String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, missionId, artifactKey])
  @@index([organizationId, missionId])
  @@map("organization_artifacts")
}

/// Decoupled from User so fetching user data never fetches password hashes.
model AuthCredential {
  id           String   @id @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

/// Authentication session — distinct from conversation.
/// Refresh tokens are stored hashed; reuse after rotation triggers family revocation.
model Session {
  id               String    @id @db.Uuid
  userId           String    @db.Uuid
  deviceId         String?   @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime  @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@map("sessions")
}

enum DevicePlatform {
  WINDOWS
  MACOS
  LINUX
  IOS
  ANDROID
  WEB
}

/// Device kind. `BROWSER_WORKER` is included because Browser Use acts as a full worker.
enum DeviceType {
  IPHONE
  ANDROID
  WINDOWS_PC
  MAC
  LINUX
  BROWSER_WORKER
}

/// Allowed device role. `BOTH` allows desktop/laptops to serve as client and worker.
enum DeviceRole {
  CLIENT
  WORKER
  BOTH
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  DEGRADED
  REVOKED
}

/// Distinct from status: a device can be online without being trusted yet (PENDING).
enum TrustState {
  PENDING
  TRUSTED
  REVOKED
}

/// Registered device: client, worker, or both.
model Device {
  id                 String         @id @db.Uuid
  userId             String         @db.Uuid
  name               String
  type               DeviceType
  platform           DevicePlatform
  role               DeviceRole
  status             DeviceStatus   @default(OFFLINE)
  trust              TrustState     @default(PENDING)
  agentVersion       String?
  /// Health reported on last heartbeat: load, battery, latency, active tasks.
  health             Json           @default("{\"activeTasks\":0,\"maxConcurrentTasks\":1}")
  /// Explicit permissions granted to THIS DEVICE in addition to user permissions.
  grantedPermissions String[]       @default([])
  metadata           Json           @default("{}")
  lastSeenAt         DateTime?      @db.Timestamptz(3)
  pairedAt           DateTime       @default(now()) @db.Timestamptz(3)
  revokedAt          DateTime?      @db.Timestamptz(3)

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        Session[]
  capabilities    DeviceCapability[]
  credentials     DeviceCredential[]
  deviceSessions  DeviceSession[]
  executions      TaskExecution[]
  originatedTasks TaskPlan[]         @relation("TaskOrigin")

  @@index([userId, role, status])
  @@index([userId, trust])
  @@map("devices")
}

/// Capability declared by a worker.
/// Normalized row-per-capability for indexing and independent enable/disable toggles.
model DeviceCapability {
  id          String   @id @db.Uuid
  deviceId    String   @db.Uuid
  name        String
  version     String   @default("1")
  description String   @default("")
  /// JSON schema for capability arguments as declared by worker.
  inputSchema Json?
  enabled     Boolean  @default(true)
  metadata    Json     @default("{}")
  declaredAt  DateTime @default(now()) @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, name])
  @@index([name, enabled])
  @@map("device_capabilities")
}

enum DeviceCredentialKind {
  ED25519_PUBLIC_KEY
  ECDSA_P256_PUBLIC_KEY
  SERVICE_TOKEN_HASH
}

/// Device authentication credential. Public key or token hash, never raw private keys.
model DeviceCredential {
  id        String               @id @db.Uuid
  deviceId  String               @db.Uuid
  kind      DeviceCredentialKind
  material  String
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  rotatedAt DateTime?            @db.Timestamptz(3)
  expiresAt DateTime?            @db.Timestamptz(3)
  revokedAt DateTime?            @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, revokedAt])
  @@map("device_credentials")
}

/// Authenticated device session. Distinct from user session.
model DeviceSession {
  id              String    @id @db.Uuid
  deviceId        String    @db.Uuid
  userId          String    @db.Uuid
  /// Token hash. Returned once upon issuance.
  tokenHash       String    @unique
  issuedAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime  @db.Timestamptz(3)
  lastHeartbeatAt DateTime  @default(now()) @db.Timestamptz(3)
  rotatedFromId   String?   @db.Uuid
  revokedAt       DateTime? @db.Timestamptz(3)
  /// Negotiated capabilities for this session, bounded by device capabilities.
  capabilities    String[]  @default([])
  remoteAddress   String?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, revokedAt])
  @@index([expiresAt])
  @@map("device_sessions")
}

enum TaskPlanStatus {
  PENDING
  RUNNING
  WAITING_FOR_CONFIRMATION
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIAL
}

enum TaskStepStatus {
  PENDING
  READY
  ASSIGNED
  RUNNING
  WAITING_FOR_CONFIRMATION
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

/// Distributed multi-device execution plan.
model TaskPlan {
  id                   String         @id @db.Uuid
  userId               String         @db.Uuid
  title                String
  /// Origin client device where request was initiated.
  originClientDeviceId String         @db.Uuid
  runId                String?        @db.Uuid
  conversationId       String?        @db.Uuid
  correlationId        String
  status               TaskPlanStatus @default(PENDING)
  metadata             Json           @default("{}")
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  startedAt            DateTime?      @db.Timestamptz(3)
  completedAt          DateTime?      @db.Timestamptz(3)

  originClient Device     @relation("TaskOrigin", fields: [originClientDeviceId], references: [id], onDelete: Cascade)
  steps        TaskStep[]

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([originClientDeviceId])
  @@map("task_plans")
}

/// Plan step. `requiredCapabilities` decides worker selection; `selectedDeviceId` assigned at runtime.
model TaskStep {
  id                   String         @id @db.Uuid
  taskId               String         @db.Uuid
  /// Readable identifier within the plan (`clone`, `test`...).
  key                  String
  description          String
  requiredCapabilities String[]
  tool                 String
  arguments            Json           @default("{}")
  dependsOn            String[]       @default([])
  selectedDeviceId     String?        @db.Uuid
  preferredDeviceId    String?        @db.Uuid
  constraints          Json?
  riskLevel            String         @default("MEDIUM")
  retryPolicy          Json           @default("{\"attempts\":1,\"backoffMs\":1000,\"failoverToAnotherDevice\":false}")
  timeoutMs            Int            @default(300000)
  status               TaskStepStatus @default(PENDING)
  attempt              Int            @default(0)
  result               Json?
  error                Json?
  startedAt            DateTime?      @db.Timestamptz(3)
  completedAt          DateTime?      @db.Timestamptz(3)

  plan       TaskPlan        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  executions TaskExecution[]

  @@unique([taskId, key])
  @@index([taskId, status])
  @@map("task_steps")
}

/// Execution attempt of a step on a designated device.
model TaskExecution {
  id          String         @id @db.Uuid
  taskId      String         @db.Uuid
  stepId      String         @db.Uuid
  deviceId    String         @db.Uuid
  attempt     Int
  status      TaskStepStatus
  startedAt   DateTime       @default(now()) @db.Timestamptz(3)
  completedAt DateTime?      @db.Timestamptz(3)
  durationMs  Int?
  /// Redacted arguments: zero secrets in audit logs.
  input       Json?
  result      Json?
  error       Json?

  step   TaskStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  device Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
  @@index([deviceId, startedAt(sort: Desc)])
  @@map("task_executions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Conversation
// ─────────────────────────────────────────────────────────────────────────────

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

model Conversation {
  id            String             @id @db.Uuid
  userId        String             @db.Uuid
  title         String?
  status        ConversationStatus @default(ACTIVE)
  pinnedAt      DateTime?          @db.Timestamptz(3)
  lastMessageAt DateTime?          @db.Timestamptz(3)
  tokenCount    Int                @default(0)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

/// `content` is an array of typed content blocks (text, tool_call, tool_result, image, audio).
/// `contentText` is the flattened text projection for full-text search.
model Message {
  id                   String      @id @db.Uuid
  conversationId       String      @db.Uuid
  role                 MessageRole
  content              Json
  contentText          String      @default("")
  originClientDeviceId String?     @db.Uuid
  runId                String?     @db.Uuid
  tokensIn             Int         @default(0)
  tokensOut            Int         @default(0)
  model                String?
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  editedAt             DateTime?   @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum MemoryLayer {
  LONG_TERM
  PREFERENCE
}

enum MemoryKind {
  SEMANTIC
  EPISODIC
  PROCEDURAL
}

enum MemoryOrigin {
  USER
  AGENT
  SYSTEM
}

enum MemorySensitivity {
  ORDINARY
  PERSONAL
}

model Memory {
  id                   String                      @id @db.Uuid
  userId               String                      @db.Uuid
  layer                MemoryLayer                 @default(LONG_TERM)
  kind                 MemoryKind
  content              String
  importance           Float
  confidence           Float
  tags                 String[]                    @default([])
  origin               MemoryOrigin                @default(USER)
  sensitivity          MemorySensitivity           @default(ORDINARY)
  sensitiveCategories  String[]                    @default([])
  /// Explicit provenance pointers without duplicating sensitive source raw text.
  sourceRunId          String?                     @db.Uuid
  sourceConversationId String?                     @db.Uuid
  sourceMessageId      String?                     @db.Uuid
  sourceUri            String?
  /// Normalized content hash for deduplication.
  contentHash          String
  /// Array copy used by Prisma and portable exports.
  embedding            Float[]                     @default([])
  embeddingVector      Unsupported("vector(384)")? @map("embedding_vector")
  embeddingModel       String?
  extractedAt          DateTime?                   @db.Timestamptz(3)
  validFrom            DateTime                    @db.Timestamptz(3)
  validUntil           DateTime?                   @db.Timestamptz(3)
  supersededById       String?                     @db.Uuid
  supersedesId         String?                     @db.Uuid
  createdAt            DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @db.Timestamptz(3)

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supersededBy       Memory?  @relation("MemorySupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)
  supersededRecords  Memory[] @relation("MemorySupersededBy")
  supersedes         Memory?  @relation("MemorySupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersedingRecords Memory[] @relation("MemorySupersedes")

  @@index([userId, layer, validUntil])
  @@index([userId, kind, validUntil])
  @@index([userId, validFrom(sort: Desc)])
  @@index([userId, contentHash, validUntil])
  @@index([sourceRunId])
  @@map("memories")
}

model Notification {
  id                   String    @id @db.Uuid
  userId               String    @db.Uuid
  title                String
  body                 String
  severity             String
  originClientDeviceId String?   @db.Uuid
  readAt               DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Registry of issued mission grant assertions.
model DevicePairingTicket {
  id         String    @id @db.Uuid
  userId     String    @db.Uuid
  /// SHA-256 of code in hex. Unique constraint guarantees one ticket per code.
  codeHash   String    @unique @db.Char(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  /// Null while unused; timestamp enforces single-use.
  consumedAt DateTime? @db.Timestamptz(3)
  /// Device created by this pairing ticket.
  deviceId   String?   @db.Uuid
  label      String?   @db.VarChar(120)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("device_pairing_tickets")
}

model MissionGrant {
  /// The `jti` of the assertion.
  id                 String            @id @db.Uuid
  missionExternalKey String            @db.VarChar(128)
  userId             String            @db.Uuid
  service            String            @db.VarChar(64)
  issuedAt           DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt          DateTime          @db.Timestamptz(3)
  status             MissionGrantState @default(ACTIVE)
  /// Retirement timestamp. Null while active.
  retiredAt          DateTime?         @db.Timestamptz(3)

  @@index([missionExternalKey, status])
  @@index([userId, status])
  @@index([expiresAt])
  @@map("mission_grants")
}

enum MissionGrantState {
  ACTIVE
  /// Retired because mission completed or cancelled. Normal flow.
  COMPLETED
  /// Revoked due to incident/mistrust.
  REVOKED
}

/// Long-lived revocable delegation grant.
model ScheduleGrant {
  id                 String             @id @db.Uuid
  tokenHash          String             @unique @db.Char(64)
  userId             String             @db.Uuid
  missionExternalKey String             @db.VarChar(128)
  scheduleId         String             @unique @db.Uuid
  status             ScheduleGrantState @default(ACTIVE)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  revokedAt          DateTime?          @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("schedule_grants")
}

enum ScheduleGrantState {
  ACTIVE
  REVOKED
}

/// Agent Core run claim for task attempts.
/// Unique constraint on (mission, task, attempt) prevents concurrent double runs.
model AgentCoreRunClaim {
  id                 String   @id @db.Uuid
  missionExternalKey String   @db.VarChar(128)
  taskKey            String   @db.VarChar(128)
  attemptId          String   @db.VarChar(128)
  runId              String   @db.Uuid
  userId             String   @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@unique([missionExternalKey, taskKey, attemptId])
  @@index([runId])
  @@map("agent_core_run_claims")
}

model AgentRunSnapshot {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  status    String
  startTime DateTime @db.Timestamptz(3)
  state     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Mission that requested this run. Null for interactive runs initiated by a user.
  missionExternalKey String? @db.VarChar(128)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startTime(sort: Desc)])
  @@index([status])
  @@index([missionExternalKey])
  @@map("agent_run_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Career and education
// Full reference: docs/architecture/career-education.md
// ─────────────────────────────────────────────────────────────────────────────

// Enum members below are spelled exactly as the domain vocabulary in
// `@nexus/career` — lowercase, snake_case — rather than upper-cased in the
// repository's older style. The vocabulary is the public API contract: a
// dashboard receives `awaiting_confirmation` and the database stores
// `awaiting_confirmation`, so there is no translation table to keep in step and
// no chance of the two drifting. The cost is a visual break with the enums
// above; the benefit is that a state read from psql is the state a client saw.

enum CareerOpportunityKind {
  phd
  permanent_job
  freelance
}

enum CareerSourceKind {
  official_site
  institutional_registry
  aggregator
  referral
  manual_entry
  unverified
}

enum CareerApplicationState {
  discovered
  shortlisted
  drafting
  awaiting_confirmation
  approved
  submitted
  interview
  offer
  rejected
  withdrawn
  expired
}

enum CareerDocumentKind {
  cv
  cover_letter
  research_statement
  portfolio_note
  reference_list
}

enum CareerDeadlineKind {
  application_deadline
  document_due
  interview
  decision_expected
  follow_up
}

enum CareerDeadlineState {
  pending
  reminded
  met
  missed
  cancelled
}

enum CareerInterviewMode {
  onsite
  video
  phone
  written
}

enum CareerInterviewState {
  scheduled
  completed
  cancelled
  no_show
}

enum CareerOutcomeResult {
  offer
  rejection
  no_response
  withdrawn
  expired
}

enum CareerFollowUpChannel {
  email_draft
  letter_draft
  manual_note
}

enum CareerFollowUpState {
  planned
  drafted
  done
  cancelled
}

enum CareerSubmissionState {
  pending
  succeeded
  failed
  refused
}

enum CareerConfirmationState {
  pending
  approved
  rejected
  expired
  cancelled
  consumed
}

enum CareerConfirmationPurpose {
  submit_application
}

/// What the owner is looking for, and what they bring. One row per account.
model CareerProfile {
  id              String   @id @db.Uuid
  userId          String   @unique @db.Uuid
  headline        String   @db.VarChar(160)
  summary         String   @db.VarChar(2000)
  yearsExperience Int
  highestDegree   String   @db.VarChar(16)
  skills          String[]
  /// Array of `{ code, level }`, validated by `languageSkillSchema`.
  languages       Json
  publications    Int      @default(0)
  /// Validated by `careerPreferencesInputSchema` before every write.
  preferences     Json
  /// Incremented on every accepted write; stamped on each document variant.
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("career_profiles")
}

/// One position, deduplicated per owner.
model CareerOpportunity {
  id           String                @id @db.Uuid
  userId       String                @db.Uuid
  kind         CareerOpportunityKind
  title        String                @db.VarChar(200)
  organization String                @db.VarChar(160)
  location     String                @db.VarChar(120)
  remote       Boolean               @default(false)
  description  String                @db.VarChar(8200)
  requirements String[]
  compensation Json?
  postedAt     DateTime?             @db.Timestamptz(3)
  closesAt     DateTime?             @db.Timestamptz(3)
  externalRef  String?               @db.VarChar(128)
  /// Tracking parameters and fragment removed. Second deduplication key.
  canonicalUrl String?               @db.VarChar(2048)
  /// SHA-256 of the normalised kind, title, organisation, location and
  /// external reference. Primary deduplication key.
  fingerprint  String                @db.Char(64)
  /// Every observation, oldest first. A second sighting appends here.
  provenance   Json
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications CareerApplication[]
  contacts     CareerContact[]

  /// Deduplication, enforced by the database rather than by a prior read.
  /// Scoped by owner: the same posting found by two accounts is two rows.
  @@unique([userId, fingerprint])
  @@unique([userId, canonicalUrl])
  @@index([userId, closesAt])
  @@index([userId, kind, createdAt(sort: Desc)])
  @@map("career_opportunities")
}

/// The owner's pursuit of one opportunity.
model CareerApplication {
  id             String                 @id @db.Uuid
  userId         String                 @db.Uuid
  opportunityId  String                 @db.Uuid
  state          CareerApplicationState @default(discovered)
  stateChangedAt DateTime               @default(now()) @db.Timestamptz(3)
  /// Ranking frozen at shortlisting. A later profile edit must not rewrite
  /// the reason a decision was made.
  matchScore     Int?
  notes          String                 @db.VarChar(2000)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity CareerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  documentVariants   CareerDocumentVariant[]
  contacts           CareerContact[]
  deadlines          CareerDeadline[]
  interviews         CareerInterview[]
  outcome            CareerOutcome?
  followUps          CareerFollowUp[]
  submissionAttempts CareerSubmissionAttempt[]
  confirmations      CareerConfirmation[]
  events             CareerApplicationEvent[]

  /// At most one application per opportunity per owner: the structural
  /// defence against applying twice to the same position.
  @@unique([userId, opportunityId])
  @@index([userId, state, updatedAt(sort: Desc)])
  @@map("career_applications")
}

/// A tailored document, with its lineage.
model CareerDocumentVariant {
  id              String             @id @db.Uuid
  userId          String             @db.Uuid
  applicationId   String             @db.Uuid
  kind            CareerDocumentKind
  revision        Int
  parentVariantId String?            @db.Uuid
  /// Profile version the body was generated from; identifies a stale draft.
  profileVersion  Int
  contentHash     String             @db.Char(64)
  body            String             @db.VarChar(40200)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  application CareerApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  parent      CareerDocumentVariant?  @relation("CareerDocumentLineage", fields: [parentVariantId], references: [id], onDelete: SetNull)
  revisions   CareerDocumentVariant[] @relation("CareerDocumentLineage")

  @@unique([applicationId, kind, revision])
  @@index([userId, applicationId])
  @@map("career_document_variants")
}

/// A person at the other end. The only table holding a third party's address.
model CareerContact {
  id            String           @id @db.Uuid
  userId        String           @db.Uuid
  applicationId String?          @db.Uuid
  opportunityId String?          @db.Uuid
  displayName   String           @db.VarChar(120)
  role          String           @db.VarChar(120)
  organization  String           @db.VarChar(160)
  /// Personal data. Never copied into an event, a notification or a log:
  /// those surfaces receive `maskEmail` output or a one-way hash.
  email         String?          @db.VarChar(254)
  notes         String           @db.VarChar(2000)
  source        CareerSourceKind @default(manual_entry)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  application CareerApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  opportunity CareerOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, applicationId])
  @@map("career_contacts")
}

/// A dated commitment, with the reminders already sent.
model CareerDeadline {
  id                     String              @id @db.Uuid
  userId                 String              @db.Uuid
  applicationId          String              @db.Uuid
  kind                   CareerDeadlineKind
  dueAt                  DateTime            @db.Timestamptz(3)
  state                  CareerDeadlineState @default(pending)
  label                  String              @db.VarChar(200)
  reminderOffsetsMinutes Int[]
  /// Append-only. A restart cannot re-notify an offset recorded here.
  remindedOffsetsMinutes Int[]
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  application CareerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, state, dueAt])
  @@index([applicationId])
  @@map("career_deadlines")
}

model CareerInterview {
  id              String               @id @db.Uuid
  userId          String               @db.Uuid
  applicationId   String               @db.Uuid
  mode            CareerInterviewMode
  stage           String               @db.VarChar(120)
  scheduledAt     DateTime             @db.Timestamptz(3)
  durationMinutes Int                  @default(60)
  state           CareerInterviewState @default(scheduled)
  notes           String               @db.VarChar(2000)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  application CareerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@index([applicationId])
  @@map("career_interviews")
}

/// How it ended. One row per application, written once.
model CareerOutcome {
  id            String              @id @db.Uuid
  userId        String              @db.Uuid
  applicationId String              @unique @db.Uuid
  result        CareerOutcomeResult
  decidedAt     DateTime            @db.Timestamptz(3)
  notes         String              @db.VarChar(2000)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  application CareerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, decidedAt(sort: Desc)])
  @@map("career_outcomes")
}

/// Text prepared for the owner to send. NEXUS never sends it.
model CareerFollowUp {
  id            String                @id @db.Uuid
  userId        String                @db.Uuid
  applicationId String                @db.Uuid
  channel       CareerFollowUpChannel
  dueAt         DateTime              @db.Timestamptz(3)
  state         CareerFollowUpState   @default(planned)
  draft         String                @db.VarChar(2200)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  application CareerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, state, dueAt])
  @@index([applicationId])
  @@map("career_follow_ups")
}

/// One attempt to hand a payload to a submission adapter.
model CareerSubmissionAttempt {
  id             String                @id @db.Uuid
  userId         String                @db.Uuid
  applicationId  String                @db.Uuid
  /// Derived from application, payload and approval. The unique index below is
  /// what makes submission exactly-once: a retry after a crash reproduces this
  /// key and collides with the row the crashed attempt already wrote.
  idempotencyKey String                @db.Char(64)
  confirmationId String                @db.Uuid
  payloadHash    String                @db.Char(64)
  adapter        String                @db.VarChar(64)
  state          CareerSubmissionState @default(pending)
  /// Opaque adapter receipt. Carries no address and no credential.
  receipt        String?               @db.VarChar(200)
  /// Already-redacted sentence, set only on failure.
  failureReason  String?               @db.VarChar(400)
  startedAt      DateTime              @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?             @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  application  CareerApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  confirmation CareerConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([applicationId, startedAt(sort: Desc)])
  @@map("career_submission_attempts")
}

/// A human decision, stored so it survives a restart.
model CareerConfirmation {
  id            String                    @id @db.Uuid
  userId        String                    @db.Uuid
  applicationId String                    @db.Uuid
  purpose       CareerConfirmationPurpose
  /// Binds the decision to exactly what was approved. Edit a document and the
  /// hash changes, so the approval no longer authorises anything.
  payloadHash   String                    @db.Char(64)
  state         CareerConfirmationState   @default(pending)
  summary       String                    @db.VarChar(400)
  requestedAt   DateTime                  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime                  @db.Timestamptz(3)
  decidedAt     DateTime?                 @db.Timestamptz(3)
  consumedAt    DateTime?                 @db.Timestamptz(3)

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  application CareerApplication         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  attempts    CareerSubmissionAttempt[]

  /// Lookup path for "is there a live approval for exactly this payload".
  /// Deliberately **not** unique: a decision is history, and an application
  /// whose first attempt failed must be able to hold a second approval for the
  /// same documents. What is unique is the set of *live* rows, enforced by a
  /// partial index the migration creates and Prisma cannot express.
  @@index([userId, applicationId, purpose, payloadHash])
  @@index([userId, state, expiresAt])
  @@map("career_confirmations")
}

/// Immutable history. Append-only: the store exposes no update and no delete.
model CareerApplicationEvent {
  id            String                  @id @db.Uuid
  userId        String                  @db.Uuid
  applicationId String                  @db.Uuid
  /// Unique per application, so a gap or a repeat is detectable.
  sequence      Int
  kind          String                  @db.VarChar(64)
  fromState     CareerApplicationState?
  toState       CareerApplicationState?
  summary       String                  @db.VarChar(400)
  /// Redacted by `redactForAudit` before the write: named personal fields
  /// dropped, secret-shaped values masked, every string bounded.
  context       Json
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  application CareerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, sequence])
  @@index([userId, createdAt(sort: Desc)])
  @@map("career_application_events")
}

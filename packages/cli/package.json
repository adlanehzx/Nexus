{
  "name": "@nexus/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Installation, diagnostic et conduite d'une instance NEXUS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nexus": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@nexus/auth": "workspace:*",
    "@nexus/config": "workspace:*",
    "@nexus/device-policy": "workspace:*",
    "@nexus/shared": "workspace:*",
    "@nexus/voice": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "vitest": "4.1.11"
  }
}
